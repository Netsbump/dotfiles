#!/usr/bin/env python3
"""Play an MSN-style nudge if a Herdr task stays unread for too long."""

from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path
from typing import Any

HOME = Path.home()
DEFAULT_HERDR = HOME / ".local/bin/herdr"
HERDR = os.environ.get(
    "HERDR_BIN",
    str(DEFAULT_HERDR) if DEFAULT_HERDR.exists() else (shutil.which("herdr") or "herdr"),
)
NUDGE_PATH = os.environ.get(
    "HERDR_WIZZ_SOUND_PATH", str(HOME / ".config/herdr/sounds/nudge.mp3")
)
DELAY_SECONDS = int(os.environ.get("HERDR_WIZZ_DELAY_SECONDS", "300"))
POLL_SECONDS = float(os.environ.get("HERDR_WIZZ_POLL_SECONDS", "5"))
STATUSES = {
    s.strip().lower()
    for s in os.environ.get("HERDR_WIZZ_STATUSES", "done").split(",")
    if s.strip()
}

# pane_id -> {since: float, nudged: bool, label: str}
pending: dict[str, dict[str, Any]] = {}


def log(message: str) -> None:
    print(f"[{time.strftime('%Y-%m-%d %H:%M:%S')}] {message}", flush=True)


def run_json(args: list[str]) -> dict[str, Any] | None:
    try:
        proc = subprocess.run(
            args,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=10,
            check=False,
        )
    except Exception as exc:
        log(f"command failed to start: {args!r}: {exc}")
        return None

    if proc.returncode != 0:
        stderr = proc.stderr.strip()
        log(f"command failed ({proc.returncode}): {' '.join(args)}{': ' + stderr if stderr else ''}")
        return None

    try:
        return json.loads(proc.stdout)
    except json.JSONDecodeError as exc:
        log(f"invalid JSON from {' '.join(args)}: {exc}")
        return None


def agent_label(agent: dict[str, Any]) -> str:
    name = agent.get("agent") or "agent"
    cwd = agent.get("foreground_cwd") or agent.get("cwd") or "?"
    pane = agent.get("pane_id") or agent.get("terminal_id") or "?"
    return f"{name} {pane} ({cwd})"


def play_sound() -> None:
    """Play directly: Herdr's notification command may be disabled when toasts are off."""
    players = [
        ["mpg123", "-q", NUDGE_PATH],
        ["pw-play", NUDGE_PATH],
        ["ffplay", "-nodisp", "-autoexit", "-loglevel", "quiet", NUDGE_PATH],
    ]

    for cmd in players:
        if not shutil.which(cmd[0]):
            continue
        try:
            subprocess.Popen(
                cmd,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
            log(f"sound launched via {cmd[0]}")
            return
        except Exception as exc:
            log(f"sound launch failed via {cmd[0]}: {exc}")

    log("no supported audio player found for wizz; install mpg123, pipewire-utils, or ffmpeg")


def nudge(label: str) -> None:
    minutes = max(1, round(DELAY_SECONDS / 60))
    body = f"{label} attend depuis environ {minutes} min"
    proc = subprocess.run(
        [
            HERDR,
            "notification",
            "show",
            "Wizz MSN",
            "--body",
            body,
            "--sound",
            "request",
        ],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        timeout=10,
        check=False,
    )
    out = (proc.stdout or proc.stderr).strip()
    if out:
        log(f"herdr notification result: {out}")
    play_sound()


def tick() -> None:
    data = run_json([HERDR, "agent", "list"])
    if not data:
        return

    agents = data.get("result", {}).get("agents", [])
    seen: set[str] = set()
    now = time.time()

    for agent in agents:
        pane_id = agent.get("pane_id") or agent.get("terminal_id")
        if not pane_id:
            continue

        seen.add(pane_id)
        status = str(agent.get("agent_status") or "unknown").lower()
        focused = bool(agent.get("focused"))
        should_track = status in STATUSES and not focused

        if not should_track:
            if pane_id in pending:
                log(f"reset {pending[pane_id]['label']} status={status} focused={focused}")
                pending.pop(pane_id, None)
            continue

        if pane_id not in pending:
            label = agent_label(agent)
            pending[pane_id] = {"since": now, "nudged": False, "label": label}
            log(f"tracking unread done: {label}")
            continue

        entry = pending[pane_id]
        age = now - float(entry["since"])
        if not entry["nudged"] and age >= DELAY_SECONDS:
            log(f"wizz: {entry['label']} unread for {int(age)}s")
            nudge(str(entry["label"]))
            entry["nudged"] = True

    for pane_id in list(pending):
        if pane_id not in seen:
            log(f"reset disappeared pane: {pending[pane_id]['label']}")
            pending.pop(pane_id, None)


def main() -> int:
    log(
        "started "
        f"delay={DELAY_SECONDS}s poll={POLL_SECONDS}s statuses={','.join(sorted(STATUSES))}"
    )
    while True:
        try:
            tick()
        except Exception as exc:
            log(f"unexpected error: {exc}")
        time.sleep(POLL_SECONDS)


if __name__ == "__main__":
    sys.exit(main())
